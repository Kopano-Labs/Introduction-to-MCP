{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopanolabs.com/schemas/kpgs/swfus-update.v1.json",
  "title": "KPGS SWFUS Progressive Update",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nodeId", "action", "telemetryValue", "data"],
  "properties": {
    "schema": { "const": "kpgs.swfus.update.v1" },
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "action": { "enum": ["CREATE", "READ", "UPDATE", "DELETE"] },
    "telemetryValue": { "type": "number", "minimum": -100, "maximum": 100 },
    "data": { "type": "object" },
    "expectedRevision": { "type": ["integer", "null"], "minimum": 0 },
    "correlationId": { "type": ["string", "null"], "minLength": 1 },
    "capabilityLeaseId": { "type": ["string", "null"], "minLength": 1 },
    "observedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nodeId",
        "requestedAction",
        "resolvedAction",
        "accepted",
        "stage",
        "syncState",
        "revision",
        "evidenceHash",
        "observedAt"
      ],
      "properties": {
        "schema": { "const": "kpgs.swfus.receipt.v1" },
        "nodeId": { "type": "string", "minLength": 1 },
        "requestedAction": { "type": "string", "minLength": 1 },
        "resolvedAction": { "enum": ["CREATE", "READ", "UPDATE", "DELETE"] },
        "accepted": { "type": "boolean" },
        "stage": {
          "enum": [
            "sovereign_ingestion",
            "witness_isolation",
            "fluid_vectoring",
            "unified_synchronization"
          ]
        },
        "syncState": { "enum": ["synced", "pending_sync", "severed", "not_applicable"] },
        "revision": { "type": ["integer", "null"], "minimum": 1 },
        "correlationId": { "type": ["string", "null"] },
        "capabilityLeaseId": { "type": ["string", "null"] },
        "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": ["string", "null"] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
