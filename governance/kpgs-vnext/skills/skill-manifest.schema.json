{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopanolabs.com/schemas/kpgs/skills/skill-manifest.schema.json",
  "title": "KPGS Governed Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "category",
    "state",
    "runtime",
    "inputs",
    "outputs",
    "required_capabilities",
    "dependencies",
    "provenance",
    "validation",
    "failures"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "category": { "type": "string", "minLength": 2, "maxLength": 100 },
    "state": { "type": "string", "enum": ["draft", "validated", "approved", "deprecated", "blocked"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renter_protocol", "platforms"],
      "properties": {
        "renter_protocol": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["human", "agent", "stateless-renter", "browser", "server", "cli"] }
        },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref"],
      "properties": {
        "schema_ref": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref"],
      "properties": {
        "schema_ref": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "resource_scope"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "resource_scope": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean", "default": false }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "version_constraint"],
        "properties": {
          "kind": { "type": "string", "enum": ["skill", "package", "service", "tool", "runtime"] },
          "name": { "type": "string", "minLength": 1 },
          "version_constraint": { "type": ["string", "null"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license_status", "sources"],
      "properties": {
        "origin": { "type": "string", "enum": ["kpgs-original", "adapted", "imported", "fork-derived-reference"] },
        "license_status": { "type": "string", "enum": ["verified-compatible", "pending", "incompatible", "unknown"] },
        "license_spdx": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "relationship"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "relationship": { "type": "string", "enum": ["inspiration", "adaptation", "import", "upstream", "reference"] },
              "commit": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_gates", "methods"],
      "properties": {
        "hard_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["schema", "unit", "integration", "e2e", "security", "accessibility", "human-review", "model-eval"]
          }
        },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "recoverability", "user_message"],
        "properties": {
          "code": { "type": "string", "minLength": 2 },
          "recoverability": { "type": "string", "enum": ["retry", "user-action", "operator-action", "not-recoverable"] },
          "user_message": { "type": "string", "minLength": 4, "maxLength": 1000 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "origin": { "enum": ["adapted", "imported", "fork-derived-reference"] }
            },
            "required": ["origin"]
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "sources": { "minItems": 1 }
            }
          }
        }
      }
    }
  ]
}
