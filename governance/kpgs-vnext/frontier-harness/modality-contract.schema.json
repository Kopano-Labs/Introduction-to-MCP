{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopanolabs.com/kpgs/frontier/modality-contract.schema.json",
  "title": "KPGS Modality Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "request_id", "semantic_ref", "primary", "renderers", "fallbacks", "accessibility", "renderer_has_semantic_authority"],
  "properties": {
    "schema_version": {"const": "kpgs.modality_contract.v1"},
    "contract_id": {"type": "string", "minLength": 8},
    "request_id": {"type": "string", "minLength": 8},
    "semantic_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary": {"enum": ["text", "visual", "speech", "haptic-event"]},
    "renderers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["native-text", "native-visual", "elevenlabs-speech", "native-event"]}},
    "fallbacks": {"type": "array", "uniqueItems": true, "items": {"enum": ["native-text", "native-visual", "native-event"]}},
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_equivalent_required", "reduced_motion_safe"],
      "properties": {
        "text_equivalent_required": {"type": "boolean"},
        "reduced_motion_safe": {"type": "boolean"}
      }
    },
    "renderer_has_semantic_authority": {"const": false}
  }
}
