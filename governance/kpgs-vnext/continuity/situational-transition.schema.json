{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopanolabs.com/schemas/kpgs/continuity/situational-transition.schema.json",
  "title": "KPGS Situational Transition Receipt",
  "description": "Receipts a bounded transition decision without prescribing a universal CCP/CDP origin order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "observed_at",
    "current_state",
    "knowable_evidence",
    "governance_invariants",
    "trigger",
    "evidence_refs",
    "invariant_refs",
    "authority",
    "decision",
    "receipt_refs",
    "proof_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "transition_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_state": {
      "type": "object",
      "description": "S_t — the bounded state actually being evaluated. No universal origin is implied.",
      "additionalProperties": true
    },
    "knowable_evidence": {
      "type": "array",
      "description": "K_t — currently knowable evidence. Unknown or conflicting evidence must remain explicit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "classification"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "string",
            "enum": ["OBSERVED", "WITNESSED", "INFERRED", "CONTRADICTORY", "UNKNOWN"]
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "governance_invariants": {
      "type": "array",
      "description": "G — admitted invariants that constrain the decision without forcing a route.",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "invariant_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_ref", "scope_ref", "admitted"],
      "properties": {
        "actor_ref": { "type": "string", "minLength": 1 },
        "scope_ref": { "type": "string", "minLength": 1 },
        "admitted": { "type": "boolean" },
        "lease_or_approval_ref": { "type": ["string", "null"] }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["CCP", "CDP", "CONVERGE", "DIVERGE", "HOLD"]
        },
        "reason": { "type": "string", "minLength": 1 },
        "next_state_ref": { "type": ["string", "null"] }
      }
    },
    "receipt_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "proof_state": {
      "type": "string",
      "enum": ["UNKNOWN", "BLOCKED", "FOC_FLAGGED", "POC_CANDIDATE", "POC_VALIDATED"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "outcome": { "const": "HOLD" } },
            "required": ["outcome"]
          }
        }
      },
      "then": {
        "properties": {
          "proof_state": {
            "enum": ["UNKNOWN", "BLOCKED", "FOC_FLAGGED", "POC_CANDIDATE"]
          }
        }
      }
    }
  ]
}
