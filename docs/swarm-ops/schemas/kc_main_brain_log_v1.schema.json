{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kopano.context/swarm/kc_main_brain_log_v1",
  "title": "kc_main_brain_log_v1",
  "type": "object",
  "required": ["schema", "ts", "kind", "summary"],
  "properties": {
    "schema": { "const": "kc_main_brain_log_v1" },
    "ts": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "kind": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "commands": { "type": ["array", "null"], "items": { "type": "string" } },
    "exit_code": { "type": ["integer", "null"] },
    "git_sha": { "type": ["string", "null"] },
    "evidence_urls": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
    "payload_ref": { "type": ["string", "null"] },
    "kimi_ack": {
      "type": ["object", "null"],
      "required": ["timestamp", "payload_ref", "status"],
      "properties": {
        "timestamp": { "type": "string" },
        "payload_ref": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
