{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/kc-dashboard && npm install && npm run build",
  "outputDirectory": "apps/kc-dashboard/dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
